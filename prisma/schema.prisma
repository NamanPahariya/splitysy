// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                    String               @id @default(cuid())
  displayName           String
  email                 String               @unique
  passwordDigest        String
  createdAt             DateTime             @default(now())
  sessions              Session[]
  createdGroups         Group[]              @relation("GroupCreator")
  groupMemberships      GroupMember[]
  expensesPaid          Expense[]            @relation("ExpensePayer")
  expenseParticipations ExpenseParticipant[]
}

model Session {
  id           String   @id @default(cuid())
  secretDigest String   @unique
  accountId    String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
}

model Group {
  id        String        @id @default(cuid())
  name      String
  creatorId String
  createdAt DateTime      @default(now())
  creator   Account       @relation("GroupCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  members   GroupMember[]
  expenses  Expense[]

  @@index([creatorId])
}

model GroupMember {
  groupId   String
  accountId String
  joinedAt  DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([groupId, accountId])
  @@index([accountId])
}

model Expense {
  id           String               @id @default(cuid())
  groupId      String
  payerId      String
  description  String
  date         DateTime
  totalCents   Int
  createdAt    DateTime             @default(now())
  group        Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payer        Account              @relation("ExpensePayer", fields: [payerId], references: [id], onDelete: Restrict)
  participants ExpenseParticipant[]

  @@index([groupId])
  @@index([payerId])
}

model ExpenseParticipant {
  expenseId  String
  accountId  String
  position   Int
  shareCents Int
  expense    Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  account    Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@id([expenseId, accountId])
  @@unique([expenseId, position])
  @@index([accountId])
}
